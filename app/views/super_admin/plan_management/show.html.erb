<div class="p-6">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold text-slate-900">Plan Management</h1>
    <p class="mt-1 text-sm text-slate-600">Configure plans, toggle features, and set pricing for new users.</p>
  </div>

  <% if notice.present? %>
    <div class="mb-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
      <%= notice %>
    </div>
  <% end %>

  <%= form_tag super_admin_plan_management_path, method: :patch do %>

    <%# Plan pricing cards %>
    <div class="mb-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <% @plans.each do |plan| %>
        <div class="rounded-lg border border-slate-200 bg-white p-5">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-slate-900"><%= plan['name'] %></h2>
            <label class="flex items-center gap-2 text-sm text-slate-600">
              <%= hidden_field_tag "plans[#{plan['name']}][enabled]", '0' %>
              <%= check_box_tag "plans[#{plan['name']}][enabled]", '1', plan['enabled'] != false, class: 'rounded border-slate-300 text-woot-500 focus:ring-woot-500' %>
              Enabled
            </label>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Price per agent ($/month)</label>
            <%= number_field_tag "plans[#{plan['name']}][price_per_agent]", plan['price_per_agent'] || 0, min: 0, step: 0.01, class: 'block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-woot-500 focus:ring-woot-500' %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Feature matrix %>
    <div class="rounded-lg border border-slate-200 bg-white overflow-hidden">
      <div class="border-b border-slate-200 bg-slate-50 px-5 py-3">
        <h2 class="text-sm font-semibold text-slate-700">Feature Matrix</h2>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-5 py-3 w-1/3">Feature</th>
              <% @plans.each do |plan| %>
                <th class="px-5 py-3 text-center"><%= plan['name'] %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% @all_features.each_with_index do |feature, idx| %>
              <tr class="<%= idx.even? ? '' : 'bg-slate-25' %>">
                <td class="px-5 py-3 text-slate-700"><%= feature['display_name'] %></td>
                <% @plans.each do |plan| %>
                  <td class="px-5 py-3 text-center">
                    <%
                      plan_feats = @plan_features[plan['name']] || []
                      checked = plan_feats.include?(feature['name'])
                    %>
                    <%= check_box_tag "plan_features[#{plan['name']}][]", feature['name'], checked, class: 'rounded border-slate-300 text-woot-500 focus:ring-woot-500', id: "feature_#{plan['name'].parameterize}_#{feature['name']}" %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-6 flex justify-end">
      <%= submit_tag 'Save Plans', class: 'rounded-lg bg-woot-500 px-6 py-2.5 text-sm font-medium text-white hover:bg-woot-600 focus:outline-none focus:ring-2 focus:ring-woot-500 focus:ring-offset-2 cursor-pointer' %>
    </div>
  <% end %>
</div>
